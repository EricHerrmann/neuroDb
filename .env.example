# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here  # Google is the provider for Gemini models
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
PUSHOVER_USER=your_pushover_user_here
PUSHOVER_TOKEN=your_pushover_token_here
HF_TOKEN=your_huggingface_token_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
SERPER_API_KEY=your_serper_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
PM_SESSION_SECRET=your_session_secret_here
# Raises the PubMed/E-utilities literature-search rate limit from 3 to 10 req/s.
# Without it, bursty search_literature runs get throttled and silently return empty.
# Semantic Scholar is intentionally unkeyed: keys are not issued to non-academic
# (gmail) accounts (see docs/testLog.md LOG-014); it runs on the shared rate limit.
NCBI_API_KEY=your_ncbi_api_key_here
# Email address sent to Unpaywall v2 API as required by their terms of service.
# Without this, OA PDF discovery via Unpaywall is skipped.
UNPAYWALL_EMAIL=

# Literature-search contact email. Sent as the `mailto` query param to OpenAlex
# and Crossref (their "polite pool" → better/faster rate limits, no key needed)
# and in the User-Agent for Europe PMC/bioRxiv. Falls back to UNPAYWALL_EMAIL if
# unset. No account required — just a reachable address.
NEURODB_CONTACT_EMAIL=
# Optional Semantic Scholar key for higher rate limits. NOTE: S2 does not issue
# keys to non-academic (e.g. gmail) accounts (see docs/testLog.md LOG-014); leave
# blank to run on the shared pool (expect occasional HTTP 429).
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
# Comma-separated provider names to disable at runtime (no redeploy). Valid names:
# pubmed, semantic_scholar, arxiv, openalex, europepmc, crossref, biorxiv.
# semantic_scholar is disabled by default: keyless access hits a saturated global
# shared pool (near-constant HTTP 429), and S2 does not issue keys to gmail/
# non-academic accounts (LOG-014, LOG-069). OpenAlex covers its citation-graph
# value. Remove it from this list to re-enable.
LITERATURE_PROVIDERS_DISABLED=semantic_scholar

# Research agent tuning
NEURODB_RESEARCH_MAX_TOOL_ITERATIONS=40
# Fallback only; the active value comes from neurodb_models.toml
# [tasks."agent.loop.neuro_research"]. Kept in sync at 8192.
NEURODB_RESEARCH_MAX_TOKENS=8192

# Model routing (Config Control Phase 1)
# Standard tier — interactive agent loops
NEURODB_AGENT_MODEL=claude-sonnet-4-6
NEURODB_RESEARCH_MODEL=claude-sonnet-4-6
# Premium tier — bounded research critique/review calls
NEURODB_PREMIUM_MODEL=claude-opus-4-7
# Economy tier — lightweight summarization tasks
NEURODB_SUMMARY_MODEL=claude-haiku-4-5-20251001
NEURODB_KNOWLEDGE_SUMMARY_MODEL=claude-haiku-4-5-20251001

# Provider selection per tier (Config Control Phase 4+)
# Valid values: anthropic, openai, gemini, groq, deepseek
# Unset or omit to use the default_provider from neurodb_models.toml (anthropic)
# NEURODB_ECONOMY_PROVIDER=groq
# NEURODB_STANDARD_PROVIDER=gemini
# NEURODB_PREMIUM_PROVIDER=openai
